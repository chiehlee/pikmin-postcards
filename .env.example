# Server-only. Never use NEXT_PUBLIC_ and never commit the real value.
OPENAI_API_KEY=

# Active UI research backend: openai_api or local_codex.
PIKMIN_AI_PROVIDER=openai_api

# OpenAI API model used when PIKMIN_AI_PROVIDER=openai_api.
PIKMIN_OPENAI_MODEL=gpt-5.6
PIKMIN_OPENAI_REASONING_EFFORT=high

# Codex CLI model used when PIKMIN_AI_PROVIDER=local_codex.
PIKMIN_CODEX_MODEL=gpt-5.6-sol
PIKMIN_CODEX_REASONING_EFFORT=high

# Optional CLI command/path when `codex` is not available on the server PATH.
PIKMIN_CODEX_COMMAND=codex

# Maximum AI jobs processed at the same time. A batch can contain any number of
# images; remaining jobs stay queued. Keep this conservative on a local Mac.
PIKMIN_AI_CONCURRENCY=2

# ImageMagick command used by the backend for deterministic Mii avatar crops.
PIKMIN_MAGICK_COMMAND=magick

# Code checkout root. `npm run local` sets this automatically.
PIKMIN_PROJECT_ROOT=

# Persistent archive root outside the Git checkout. The default installer path
# is the sibling directory ../pikmin-postcards-data.
PIKMIN_DATA_ROOT=

# Server-side database adapter. The browser never receives these values.
# SQLite uses a file path and therefore has no username/password. When unset,
# the path is <PIKMIN_DATA_ROOT>/runtime/pikmin-postcards.sqlite3 via symlink.
PIKMIN_DB_DRIVER=sqlite
PIKMIN_DATABASE_PATH=

# Persistent server-side address geocoder. The public default is deliberately
# rate-limited and identified; set a compatible self-hosted endpoint for larger archives.
PIKMIN_GEOCODER_URL=https://nominatim.openstreetmap.org/search
PIKMIN_GEOCODER_USER_AGENT=PikminPostcardArchive/0.1 (+https://github.com/chiehlee/pikmin-postcards)
