{
  "name": "pikmin-postcards",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev --host 0.0.0.0",
    "build": "vinext build",
    "start": "vinext start",
    "start:lan": "vinext start --host 0.0.0.0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "normalize:bootstrap": "node scripts/normalize-current-session.mjs",
    "backfill:acquisition": "node --disable-warning=ExperimentalWarning scripts/backfill-acquisition.mjs",
    "backfill:research-details": "node --disable-warning=ExperimentalWarning scripts/backfill-research-details.mjs",
    "merge:bundle": "node --disable-warning=ExperimentalWarning scripts/merge-session-bundle.mjs",
    "check:duplicate": "node --disable-warning=ExperimentalWarning scripts/check-duplicate.mjs",
    "image:ingest": "node --disable-warning=ExperimentalWarning scripts/ingest-image.mjs",
    "friends:avatars": "node --disable-warning=ExperimentalWarning scripts/generate-friend-avatars.mjs",
    "related:candidates": "node --disable-warning=ExperimentalWarning scripts/find-related-candidates.mjs",
    "research:redo": "node --disable-warning=ExperimentalWarning scripts/apply-research-redo.mjs",
    "db:sync": "node --disable-warning=ExperimentalWarning scripts/db-sync.mjs",
    "db:export": "node --disable-warning=ExperimentalWarning scripts/db-export.mjs",
    "db:verify": "node --disable-warning=ExperimentalWarning scripts/db-verify.mjs",
    "db:stats": "node --disable-warning=ExperimentalWarning scripts/db-stats.mjs",
    "test": "npm run test:all",
    "test:unit": "node --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include='lib/**/*.mjs' --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=95 --test tests/*.unit.test.mjs",
    "test:regression": "node --disable-warning=ExperimentalWarning --test tests/*.regression.test.mjs",
    "test:functional": "npm run build && node --disable-warning=ExperimentalWarning --test tests/*.functional.test.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ui:headed": "npm run build && playwright test --headed",
    "test:all": "npm run test:unit && npm run test:regression && npm run test:functional && npm run test:ui",
    "test:quick": "npm run test:unit && npm run test:regression",
    "test:watch": "node --disable-warning=ExperimentalWarning --watch --test tests/*.unit.test.mjs tests/*.regression.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test:all && npm run lint && npm run typecheck && npm run db:verify && npm run db:stats"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
