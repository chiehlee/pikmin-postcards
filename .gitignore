# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
*.tsbuildinfo

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example
/.pikmin-local.json

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Personal archive data lives beside the repository. `npm run setup:local`
# migrates these paths and reconnects them as ignored symlinks.
/data
/public/images
/research/raw
/imports/source-bundles
/var
/.wrangler/logs

# Unpacked collection exports and one-off recovery material are archive data,
# not application source. Keep them beside the repository with the rest of the
# mutable archive.
/imports/*/
/research/recovery/
